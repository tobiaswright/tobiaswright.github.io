---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Section_About from "../components/homepage/Section-about.md";
import Section_Now from "../components/homepage/Section-now.md";
import Section_Projects from "../components/homepage/Section-projects.md";
import Section_Write from "../components/homepage/Section-write.astro";
import Section_Share from "../components/homepage/Section-share.astro";


const nowDate = "11/12/2026";
const now = [
  "Looking for a job",
  "Brushing up on my algorithms",
  "Working on a bookmarking app",
  "Playing Minecraft"
]
const nowTitles = ["Dungeon Crawler Carl #2"]
const nowWatching = ["The Expanse"]
---

<Layout title="Welcome to Tobias Wright">

  <Section header="">
    <Section_About />
  </Section>

  <!-- <Section header="projects">
    <Section_Projects />
  </Section> -->

  <Section header="writing">
    <Section_Write />
  </Section>

  <Section header="now">
    <p>
      What I'm doing these days. Last updated {nowDate}
    </p>
    <ul>
      {now.map((now) => <li>{now}</li>)}
    </ul>
    <h4>Reading</h4>
    <ul>
      {nowTitles.map((title) => <li>{title}</li>)}
    </ul>
    <h4>Watching</h4>
    <ul>
      {nowWatching.map((title) => <li>{title}</li>)}
    </ul>
  </Section>

  <!-- <Section_Share /> -->
</Layout>
